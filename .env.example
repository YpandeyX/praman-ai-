# Praman AI Environment Configuration Example
# Copy to .env and configure as appropriate

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./storage/db/praman_ai.db

# Storage Directories
STORAGE_DIR=./storage
UPLOADS_DIR=./storage/uploads
REPORTS_DIR=./storage/reports

# Verification Parameters
EXACT_MATCH_THRESHOLD=0.99
MODIFIED_QUOTE_MIN_THRESHOLD=0.65
MAX_UPLOAD_SIZE_MB=25

# Optional LLM integration (for future auxiliary explanatory generation)
# PRAMAN_AI_API_KEY=your_key_here
